# Required Discord configuration
DISCORD_TOKEN=your_discord_bot_token_here

# Required only for managing the original Minecraft server
OLD_RCON_PASSWORD=your_rcon_password_here

# Optional Hardcore server overrides
# Remove the # only when overriding a default.
# HC_SERVER_DIRECTORY=C:\path\to\hardcore_server
# HC_JAVA_EXECUTABLE=C:\path\to\java.exe
# HC_SERVER_PORT=25565
# HC_MIN_MEMORY=2G
# HC_MAX_MEMORY=4G

# Discord users permitted to control the server, separated by commas
AUTHORIZED_USER_IDS=your_discord_user_id_here

# Original Minecraft server configuration
OLD_JAVA_EXECUTABLE='C:\path\to\java.exe'
OLD_SERVER_DIRECTORY='C:\path\to\minecraft_server'